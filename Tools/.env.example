# Copie ce fichier vers .env puis renseigne tes vraies clés.
# .env ne doit JAMAIS être commit (déjà couvert par le .gitignore du projet).

# ── OpenAI (OBLIGATOIRE) ─────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ── Trigger.dev (recommandé — résumé du soir programmé) ─────────────
# https://cloud.trigger.dev -> Project settings -> API keys
TRIGGER_API_KEY=your-trigger-dev-api-key-here
TRIGGER_PROJECT_ID=your-trigger-dev-project-id-here
# Heure de déclenchement du résumé du soir, format 24h "HH:MM"
TRIGGER_EVENING_SUMMARY_TIME=20:00

# ── Auth0 (OPTIONNEL — seulement si multi-utilisateurs) ──────────────
# https://manage.auth0.com -> Applications -> ton app -> Settings
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id-here
AUTH0_CLIENT_SECRET=your-auth0-client-secret-here

# ── Exa (OPTIONNEL — recherche de conseils/ressources) ───────────────
# https://dashboard.exa.ai/api-keys
EXA_API_KEY=your-exa-api-key-here

# ── CopilotKit (OPTIONNEL — UI agentique côté frontend) ──────────────
# https://cloud.copilotkit.ai -> Settings -> API keys
# Clé PUBLIQUE (ck_pub_...), pensée pour être exposée côté client.
# Utilisée par le frontend Next.js via NEXT_PUBLIC_COPILOTKIT_PUBLIC_API_KEY
# (voir copilotkit_setup.md) — stockée ici uniquement pour centraliser/tester.
COPILOTKIT_PUBLIC_API_KEY=ck_pub_your-copilotkit-public-api-key-here
